# ─── upload-to-har local test environment ────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real tokens.
#
# To switch between local and QA, change HAR_API_URL (and HAR_ACCOUNT if the
# account ID differs between environments). Everything else is the same shape.

# ── API base URL ──────────────────────────────────────────────────────────────
#
# The harness CLI (hc) treats this as a raw base URL and appends its own path
# suffixes internally:
#   /gateway/har/api/v1   — registry v1 calls
#   /gateway/har/api/v2   — registry v2 calls
#   /har/api/v3           — system/info and v3 registry calls (no /gateway prefix)
#   /ng/api/accounts/<id> — credential validation at login time
#
# So pass the bare origin — no trailing slash, no extra path segment.
#
# LOCAL instance (http, no TLS — local instances typically run plain HTTP):
HAR_API_URL=http://localhost:3000
#
# QA instance — uncomment and comment out the local line above:
# HAR_API_URL=https://qa.harness.io
#
# Prod — uncomment for production:
# HAR_API_URL=https://app.harness.io

# ── Account ID ────────────────────────────────────────────────────────────────
#
# For your LOCAL instance: open http://localhost:3000 in a browser, log in,
# and look at the URL — it usually embeds the account as
#   /account/<accountId>/...
# Copy that value here.
#
# For QA/Prod: your account ID appears in the Harness UI under
#   Account Settings → Overview → Account Id.
HAR_ACCOUNT=REPLACE_WITH_YOUR_ACCOUNT_ID

# ── PAT token ─────────────────────────────────────────────────────────────────
#
# Create a Personal Access Token in the Harness UI:
#   Account Settings → My Profile → My API Keys → + Token
#
# The token format is typically: pat.<accountId>.<randomA>.<randomB>
# (The CLI can also extract the account ID from the token automatically
# in interactive mode, but we set it explicitly above for non-interactive use.)
HAR_TOKEN=REPLACE_WITH_YOUR_PAT_TOKEN

# ── Registry ──────────────────────────────────────────────────────────────────
#
# The name of an existing registry in your HAR instance.
# Create one via: Artifact Registry → + New Registry
HAR_REGISTRY=REPLACE_WITH_REGISTRY_NAME

# ── Artifact type ─────────────────────────────────────────────────────────────
#
# One of: generic, docker, maven, rpm, npm, conda, composer, go, cargo,
#         dart, python, nuget, swift, puppet, debian
#
# For a quick smoke-test with any file, use "generic".
HAR_TYPE=generic

# ── Local file to upload ──────────────────────────────────────────────────────
#
# Must exist on disk before running the script.
# Quick way to create a test file:
#   echo "hello from upload-to-har test" > /tmp/test-artifact.txt
HAR_FILE=/tmp/test-artifact.txt

# ── Artifact name (used by "generic" type; CLI reads name from metadata for other types) ──
HAR_NAME=test-artifact

# ── Version ───────────────────────────────────────────────────────────────────
HAR_VERSION=0.0.1

# ── Extra CLI args (optional, newline-separated) ──────────────────────────────
#
# Example — include hidden files when uploading a directory:
#   HAR_EXTRA_ARGS=--include-hidden
HAR_EXTRA_ARGS=
